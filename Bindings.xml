<Bindings>
	<!-- The game's Key Bindings menu, AddOns: "Toggle Guild Master Forever"
	     (MainKey.lua names it and the header). The game loads this file from the addon's folder by
	     itself: it is not in the TOC. No key is bound here; the player picks one, and the game saves
	     it as any of their bindings. -->
	<Binding name="GMF_TOGGLE" header="GUILDMASTERFOREVER" category="ADDONS">
		GuildMasterForeverToggleBinding(keystate)
	</Binding>
</Bindings>
